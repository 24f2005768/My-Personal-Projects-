# Database connection string
# SQLite (default, no setup needed):
DB_URI=sqlite:///data/sample.db

# Postgres example:
# DB_URI=postgresql://user:password@localhost:5432/mydb

# MySQL example:
# DB_URI=mysql+pymysql://user:password@localhost:3306/mydb

# SQL Server example:
# DB_URI=mssql+pyodbc://user:password@localhost:1433/mydb?driver=ODBC+Driver+17+for+SQL+Server

# Optional: restrict which tables the LLM sees (comma-separated)
# SCHEMA_TABLES=orders,customers,products

# LLM API key (Groq)
GROQ_API_KEY=***REMOVED***